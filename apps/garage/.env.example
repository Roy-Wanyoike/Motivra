# Motivra Garage environment variables (copy to .env.local)
# NONE of these are NEXT_PUBLIC_*: the browser bundle reads nothing —
# every upstream call is made server-side (server components + route
# handlers) with the garage staff member's own short-lived access token.

# --- Upstream services -----------------------------------------------------
# Per-service URLs. Anything unset falls back to GARAGE_API_BASE_URL (the
# gateway), then to the local host-run defaults shown below (RUNBOOK §2
# port map; same convention as apps/command).
# In the compose stack set these to the service names (http://identity:8080 …).
GARAGE_IDENTITY_URL=http://localhost:8081
GARAGE_JOBS_URL=http://localhost:8083
GARAGE_PAYMENTS_URL=http://localhost:8085

# Optional gateway base used for any service without a specific URL above.
GARAGE_API_BASE_URL=

# --- Token verification (ADR-0007 posture) ----------------------------------
# Garage is a VERIFIER: it fetches public keys from the identity JWKS and
# holds no signing material. Defaults derive from GARAGE_IDENTITY_URL.
GARAGE_JWKS_URL=
# Expected iss/aud claims — must match MOTIVRA_JWT_ISSUER / MOTIVRA_JWT_AUDIENCE.
GARAGE_JWT_ISSUER=motivra-identity
GARAGE_JWT_AUDIENCE=motivra

# Legacy HS256 acceptance (migration window ONLY, mirrors
# MOTIVRA_JWT_ALLOW_HS256 + MOTIVRA_JWT_SECRET). Leave unset in production:
# asymmetric keys only, per ADR-0007.
GARAGE_JWT_ALLOW_HS256=
GARAGE_JWT_SECRET=

# --- Console behaviour -------------------------------------------------------
# Panel auto-refresh interval in seconds (minimum 5, default 20).
GARAGE_AUTO_REFRESH_SECONDS=20
# Upstream fetch timeout in milliseconds (default 4000).
GARAGE_UPSTREAM_TIMEOUT_MS=4000
