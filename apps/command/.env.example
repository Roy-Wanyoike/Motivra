# Motivra Command environment variables (copy to .env.local)
# NONE of these are NEXT_PUBLIC_*: the browser bundle reads nothing —
# every upstream call is made server-side (server components + route
# handlers) with the operator's own short-lived access token.

# --- Upstream services -----------------------------------------------------
# Per-service URLs. Anything unset falls back to COMMAND_API_BASE_URL (the
# gateway), then to the local host-run defaults shown below (RUNBOOK §2c).
# In the compose stack set these to the service names (http://identity:8080 …).
COMMAND_IDENTITY_URL=http://localhost:8081
COMMAND_VEHICLES_URL=http://localhost:8082
COMMAND_JOBS_URL=http://localhost:8083
COMMAND_DISPATCH_URL=http://localhost:8084
COMMAND_PAYMENTS_URL=http://localhost:8085
COMMAND_INSPECTIONS_URL=http://localhost:8086

# Optional gateway base used for any service without a specific URL above.
COMMAND_API_BASE_URL=

# --- Token verification (ADR-0007 posture) ----------------------------------
# Command is a VERIFIER: it fetches public keys from the identity JWKS and
# holds no signing material. Defaults derive from COMMAND_IDENTITY_URL.
COMMAND_JWKS_URL=
# Expected iss/aud claims — must match MOTIVRA_JWT_ISSUER / MOTIVRA_JWT_AUDIENCE.
COMMAND_JWT_ISSUER=motivra-identity
COMMAND_JWT_AUDIENCE=motivra

# Legacy HS256 acceptance (migration window ONLY, mirrors
# MOTIVRA_JWT_ALLOW_HS256 + MOTIVRA_JWT_SECRET). Leave unset in production:
# asymmetric keys only, per ADR-0007.
COMMAND_JWT_ALLOW_HS256=
COMMAND_JWT_SECRET=

# --- Console behaviour -------------------------------------------------------
# Panel auto-refresh interval in seconds (minimum 5, default 20).
COMMAND_AUTO_REFRESH_SECONDS=20
# Upstream fetch timeout in milliseconds (default 4000).
COMMAND_UPSTREAM_TIMEOUT_MS=4000
