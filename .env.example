# Motivra — environment template (issues #25/#31).
#
# Every key below is one the platform actually reads in
# backend/platform/config.go (func Load / func Validate). Copy to `.env` for
# `docker compose -f docker-compose.app.yml up` (compose reads `.env` next to
# the compose file automatically). Values here are placeholders / dev-only
# defaults — NEVER commit real secrets.
#
# Per-process note: MOTIVRA_APP_NAME / MOTIVRA_PORT are per-service values;
# the compose stack sets them per container, so you normally do NOT need to
# export them for `make stack-up`.

# ---------------------------------------------------------------------------
# PostgreSQL container (docker-compose.app.yml — compose interpolation only;
# not read by Go code directly, which receives the assembled URL instead).
# ---------------------------------------------------------------------------
# POSTGRES_PASSWORD is REQUIRED by the app stack (no default). Generate one:
#   openssl rand -base64 24
# The user/db names below are fine to keep for a single-node deployment.
POSTGRES_USER=motivra
POSTGRES_PASSWORD=
POSTGRES_DB=motivra

# ---------------------------------------------------------------------------
# App identity — backend/platform/config.go (AppConfig)
# ---------------------------------------------------------------------------
# Service process name (default "motivra"). Compose sets identity/vehicles/
# jobs/dispatch per service.
MOTIVRA_APP_NAME=motivra
# development | test | staging | production (default "development").
# Validate(): must be one of these four.
MOTIVRA_ENV=development
# HTTP listen port (default "8080"). Validate(): numeric, 1-65535.
MOTIVRA_PORT=8080

# ---------------------------------------------------------------------------
# Database — DatabaseConfig
# ---------------------------------------------------------------------------
# Required (boot exits without it in every env except "test"). libpq URL.
# In the compose stack it is assembled from the POSTGRES_* values above;
# set this directly only for non-compose runs (e.g. `go run ./cmd/identity`).
# MOTIVRA_DATABASE_URL=postgres://motivra:motivra@localhost:5433/motivra?sslmode=disable

# ---------------------------------------------------------------------------
# Redis — RedisConfig (cache/ephemeral coordination only; never a source of
# truth for money or history — ADR-0003)
# ---------------------------------------------------------------------------
# Consumed since issue #87: when set, the platform rate limiter becomes the
# Redis-backed sliding-window implementation shared by every replica
# (cross-instance 429 consistency); unset falls back to the in-process
# limiter (single-instance only). Compose default: redis://redis:6379/0
MOTIVRA_REDIS_URL=redis://localhost:6380/0

# ---------------------------------------------------------------------------
# NATS — NATSConfig (event backbone, JetStream — ADR-0002)
# ---------------------------------------------------------------------------
# Not consumed by any service yet (publishers land with the notifications
# wave). Compose default: nats://nats:4222
# MOTIVRA_NATS_URL=nats://localhost:4223

# ---------------------------------------------------------------------------
# Temporal — TemporalConfig (workflows owned by domains — ADR-0001)
# ---------------------------------------------------------------------------
# Out of scope for the current app stack (see docs/RUNBOOK.md known
# limitations). Namespace defaults to "default" when unset.
# MOTIVRA_TEMPORAL_ADDRESS=localhost:7233
# MOTIVRA_TEMPORAL_NAMESPACE=default

# ---------------------------------------------------------------------------
# JWT — JWTConfig (ADR-0007, issue #87: asymmetric signing)
# ---------------------------------------------------------------------------
# Identity is the ONLY issuer: it signs access tokens (Ed25519 by default,
# RS256 supported) with a private key PEM and serves the public JWKS at
# /.well-known/jwks.json. Verifying services hold NO secret material — they
# set MOTIVRA_JWT_JWKS_URL (or a distributed MOTIVRA_JWT_PUBLIC_KEY_FILE).
# Rotation is a two-phase kid procedure: docs/RUNBOOK.md §8a.
#
# Issuer (identity) — required in every non-test env:
MOTIVRA_JWT_PRIVATE_KEY_FILE=
# Key id advertised in the JWKS and token kid header (default derived):
MOTIVRA_JWT_KEY_ID=identity-1
# Verifiers — set ONE of:
MOTIVRA_JWT_JWKS_URL=
# MOTIVRA_JWT_PUBLIC_KEY_FILE=
# Migration-window legacy path (NEVER the target posture; requires the
# secret below; retire before public launch):
# MOTIVRA_JWT_ALLOW_HS256=1
# Shared secret: keys refresh-session digests on identity (all sessions die
# on rotation) and the HS256 migration path only. >= 32 bytes outside
# "test"; the historical dev placeholder is refused. Generate:
#   openssl rand -base64 48
MOTIVRA_JWT_SECRET=
# ---------------------------------------------------------------------------
# Hardening — hardening issue #81
# ---------------------------------------------------------------------------
# Internal Prometheus exposition listener (default ":9090"). Metrics are
# NEVER served on the public API port; keep this off any host publishing.
# MOTIVRA_METRICS_ADDR=:9090
# Honour X-Forwarded-For for client IPs (default "false"). Set true ONLY
# behind a trusted proxy/ingress; otherwise callers can spoof audit IPs and
# rate-limit keys.
# MOTIVRA_TRUST_FORWARDED=false
# Authentication requests per minute per client IP on the public auth
# endpoints (default "60"; "0" disables).
# MOTIVRA_AUTH_RATE_LIMIT_RPM=60
# Issuer claim the identity service writes and every validator expects
# (default "motivra-identity").
MOTIVRA_JWT_ISSUER=motivra-identity
# Audience claim (default "motivra").
MOTIVRA_JWT_AUDIENCE=motivra

# ---------------------------------------------------------------------------
# OpenTelemetry — OTelConfig
# ---------------------------------------------------------------------------
# Enables OTLP trace export. Validate(): requires the endpoint when true.
# Defaults to ON when MOTIVRA_ENV=production (ADR-0005: a production
# deployment must not silently run without telemetry). With the
# observability stack running, set:
#   MOTIVRA_OTEL_ENABLED=true
#   OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
MOTIVRA_OTEL_ENABLED=false
# OTLP/gRPC collector endpoint, e.g. http://localhost:4317.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# Shutdown — Config.ShutdownTimeout
# ---------------------------------------------------------------------------
# Graceful-shutdown budget per service (Go duration, default "15s").
MOTIVRA_SHUTDOWN_TIMEOUT=15s

# ---------------------------------------------------------------------------
# Password breach check + account verification (identity, issues #86/#98)
# ---------------------------------------------------------------------------
# HIBP k-anonymity breach lookup on top of the always-on local denylist;
# only the 5-char SHA-1 prefix leaves the process. Default false.
MOTIVRA_HIBP_ENABLED=false
# true = refuse registration/password change while the breach check cannot
# complete; false (default) = fail OPEN with an audit note.
MOTIVRA_BREACH_FAIL_CLOSED=false
# Optional extra denied-passwords file (one per line, '#' comments).
# MOTIVRA_BREACH_DENYLIST_FILE=
# Verification flow (single-use email/phone tokens; providers land later —
# until then local flows need MOTIVRA_VERIFICATION_DEV_ECHO=1, which refuses
# to boot in staging/production):
MOTIVRA_VERIFICATION_GRACE=24h
MOTIVRA_VERIFICATION_TOKEN_TTL=24h
MOTIVRA_VERIFICATION_RESEND_COOLDOWN=1m
MOTIVRA_VERIFICATION_RESEND_LIMIT=5
# MOTIVRA_VERIFICATION_DEV_ECHO=1

# ---------------------------------------------------------------------------
# Payments (payments service, issue #62 — full contract in
# backend/payments/README.md)
# ---------------------------------------------------------------------------
# sandbox (default, deterministic, local-dev/test) | daraja (STK push + C2B;
# partial Daraja config REFUSES boot — never silently fakes).
MOTIVRA_PAYMENTS_PROVIDER=sandbox
# HMAC secret for webhook signature verification — REQUIRED outside
# development/test. Rotate per RUNBOOK §8; register the public callback URL
# with the provider (owner action).
MOTIVRA_PAYMENTS_WEBHOOK_SECRET=
# Missed-webhook reconciliation sweep cadence (Go duration).
MOTIVRA_PAYMENTS_RECONCILE_INTERVAL=1m
# Daraja adapter (all REQUIRED when MOTIVRA_PAYMENTS_PROVIDER=daraja):
# MOTIVRA_PAYMENTS_DARAJA_BASE_URL=
# MOTIVRA_PAYMENTS_DARAJA_CONSUMER_KEY=
# MOTIVRA_PAYMENTS_DARAJA_CONSUMER_SECRET=
# MOTIVRA_PAYMENTS_DARAJA_SHORTCODE=
# MOTIVRA_PAYMENTS_DARAJA_PASSKEY=
# MOTIVRA_PAYMENTS_DARAJA_INITIATOR=
# MOTIVRA_PAYMENTS_DARAJA_SECURITY_CREDENTIAL=
# MOTIVRA_PAYMENTS_DARAJA_CALLBACK_URL=
# MOTIVRA_PAYMENTS_DARAJA_WEBHOOK_SECRET=
