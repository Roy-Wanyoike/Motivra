{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "customer": { "root": "apps/customer" },
    "app": { "root": ".", "runtime": "container", "entrypoint": "Dockerfile.vercel" }
  },
  "rewrites": [
    { "source": "/v1/(.*)", "destination": { "service": "app" } },
    { "source": "/healthz", "destination": { "service": "app" } },
    { "source": "/readyz", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "customer" } }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
